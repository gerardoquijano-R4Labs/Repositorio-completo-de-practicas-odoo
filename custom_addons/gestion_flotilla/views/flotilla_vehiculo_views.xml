<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vista Lista (Tree) -->
    <record id="view_flotilla_vehiculo_tree" model="ir.ui.view">
        <field name="name">flotilla.vehiculo.tree</field>
        <field name="model">flotilla.vehiculo</field>
        <field name="arch" type="xml">
            <tree string="Vehículos">
                <field name="placa"/>
                <field name="modelo"/>
                <field name="conductor_id"/>
            </tree>
        </field>
    </record>

    <!-- 2. Vista Formulario (Form) -->
    <record id="view_flotilla_vehiculo_form" model="ir.ui.view">
        <field name="name">flotilla.vehiculo.form</field>
        <field name="model">flotilla.vehiculo</field>
        <field name="arch" type="xml">
            <form string="Vehículo">
                <sheet>
                    <group>
                        <field name="placa"/>
                        <field name="modelo"/>
                        <field name="conductor_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Acción de Ventana (Abre las vistas al hacer clic en el menú) -->
    <record id="action_flotilla_vehiculo" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">flotilla.vehiculo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- 4. Menú Superior y Submenú en Odoo -->
    <menuitem id="menu_flotilla_root" name="Flotilla" sequence="10"/>
    <menuitem id="menu_flotilla_vehiculo" name="Vehículos" parent="menu_flotilla_root" action="action_flotilla_vehiculo" sequence="10"/>
</odoo>